    "Tip: een blauwe wimpel aan de molen betekent dat de molenaar er is en je meestal binnen mag.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: a blue pennant on the windmill means the miller is there and you can usually go inside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Ein blauer Wimpel an der Mühle bedeutet, dass der Müller da ist und man meist hinein darf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : un fanion bleu sur le moulin signifie que le meunier est là et que l’on peut généralement entrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: un banderín azul en el molino significa que el molinero está y normalmente puedes entrar."
          }
