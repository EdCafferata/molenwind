    "Bij windomslag (30 min vooraf) en harde wind (1 uur vooraf)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the wind shifts (30 min ahead) and for strong wind (1 hour ahead)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Winddrehung (30 Min. vorher) und starkem Wind (1 Std. vorher)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de vent (30 min avant) et vent fort (1 h avant)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de viento (30 min antes) y viento fuerte (1 h antes)"
          }
        }
      }
    },
