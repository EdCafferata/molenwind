    "Goed maalweer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good milling weather"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gutes Mahlwetter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon temps pour moudre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen tiempo para moler"
          }
        }
      }
    },
    "Goede draaidag: genoeg wind om te malen. Of hij draait, hangt af van de molenaar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good day for turning: enough wind to mill. Whether it turns depends on the miller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Mahltag: genug Wind zum Mahlen. Ob sie sich dreht, hängt vom Müller ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne journée pour tourner : assez de vent pour moudre. Tout dépend du meunier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen día para girar: viento suficiente para moler. Que gire depende del molinero."
          }
        }
      }
    },
    "Gratis en open source. Voor molenaars die de wind willen weten, en voor iedereen die molens wil ontdekken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free and open source. For millers who need to know the wind, and for everyone who wants to discover windmills."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos und Open Source. Für Müller, die den Wind kennen müssen, und für alle, die Mühlen entdecken möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit et open source. Pour les meuniers qui veulent connaître le vent, et pour tous ceux qui veulent découvrir les moulins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis y de código abierto. Para molineros que necesitan conocer el viento y para todos los que quieren descubrir molinos."
          }
        }
      }
    },
    "Harde wind bij %@": {
      "localizations": {
        "en": {
          "stringUnit": {
