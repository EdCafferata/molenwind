    "Zodat de wieken weer vol in de wind staan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the sails can catch the full wind again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit die Flügel wieder voll im Wind stehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les ailes reprennent tout le vent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que las aspas vuelvan a coger todo el viento."
          }
        }
      }
    },
