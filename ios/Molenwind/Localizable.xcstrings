    "Dank je wel! Hiermee blijft Molenwind gratis en draaien de molens door. 🌬️": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you! This keeps Molenwind free and the windmills turning. 🌬️"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! So bleibt Molenwind kostenlos und die Mühlen drehen sich weiter. 🌬️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Molenwind reste gratuit et les moulins continuent de tourner. 🌬️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Así Molenwind sigue siendo gratis y los molinos siguen girando. 🌬️"
          }
        }
      }
    },
    "De betaling kon niet worden gecontroleerd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment could not be verified."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung konnte nicht überprüft werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement n’a pas pu être vérifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el pago."
          }
        }
      }
    },
    "De windinformatie is een hulpmiddel. De molenaar beslist zelf of en hoe er gedraaid wordt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind information is a guide. The miller decides whether and how the windmill turns."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Windinformation ist eine Hilfe. Der Müller entscheidet selbst, ob und wie die Mühle läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de vent sont indicatives. Le meunier décide si et comment le moulin tourne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información del viento es orientativa. El molinero decide si el molino gira y cómo."
          }
        }
      }
    },
    "Dit is mijn molen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is my windmill"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist meine Mühle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est mon moulin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es mi molino"
          }
        }
      }
    },
    "Een fooi is vrijwillig. Alle functies blijven gratis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tip is voluntary. All features stay free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Trinkgeld ist freiwillig. Alle Funktionen bleiben kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pourboire est facultatif. Toutes les fonctions restent gratuites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propina es voluntaria. Todas las funciones siguen siendo gratis."
          }
        }
      }
    },
    "Een review helpt andere molenaars en molenliefhebbers de app te vinden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A review helps other millers and windmill lovers find the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bewertung hilft anderen Müllern und Mühlenfreunden, die App zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avis aide d’autres meuniers et amoureux des moulins à trouver l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una reseña ayuda a otros molineros y amantes de los molinos a encontrar la app."
          }
        }
      }
    },
    "Er ging iets mis: %@": {
      "localizations": {
