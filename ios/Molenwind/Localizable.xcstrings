    "Bron: OpenStreetMap. Controleer bij twijfel de website van de molen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: OpenStreetMap. If in doubt, check the windmill’s website."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle: OpenStreetMap. Im Zweifel die Website der Mühle prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source : OpenStreetMap. En cas de doute, consultez le site du moulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente: OpenStreetMap. Si tienes dudas, consulta la web del molino."
          }
        }
      }
    },
