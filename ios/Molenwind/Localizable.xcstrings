    "Rond %@ draait de wind naar %@ (nu %@). Tijd om te kruien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Around %@ the wind turns to %@ (now %@). Time to turn the cap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen %@ dreht der Wind auf %@ (jetzt %@). Zeit, die Kappe zu drehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers %@ le vent tourne au %@ (actuellement %@). Il est temps d’orienter le moulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia las %@ el viento gira al %@ (ahora %@). Hora de orientar el molino."
          }
        }
      }
    },
    "Rond %@ draait de wind naar %@ — opnieuw kruien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Around %@ the wind turns to %@ — turn the cap again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen %@ dreht der Wind auf %@ — Kappe erneut drehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers %@ le vent tourne au %@ — réorientez le moulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia las %@ el viento gira al %@ — vuelve a orientar el molino."
          }
        }
      }
    },
    "Rond %@ verwacht: Bft %lld, stoten Bft %lld. Denk aan stilzetten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected around %@: Bft %lld, gusts Bft %lld. Consider stopping the windmill."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen %@ erwartet: Bft %lld, Böen Bft %lld. An das Anhalten denken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévu vers %@ : Bft %lld, rafales Bft %lld. Pensez à arrêter le moulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsto hacia las %@: Bft %lld, rachas Bft %lld. Piensa en parar el molino."
          }
        }
      }
    },
