    "Weinig kans dat hij draait: te weinig of te veel wind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlikely to be turning: too little or too much wind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrscheinlich steht sie still: zu wenig oder zu viel Wind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de chances qu’il tourne : trop peu ou trop de vent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es poco probable que gire: poco o demasiado viento."
          }
        }
