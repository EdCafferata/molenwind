    "Windverwachting: KNMI Harmonie (2 km) via Open-Meteo, CC-BY 4.0. Wind op 10 m hoogte. Alleen een hulpmiddel — de molenaar beslist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wind forecast: KNMI Harmonie (2 km) via Open-Meteo, CC-BY 4.0. Wind at 10 m height. Only a guide — the miller decides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windvorhersage: KNMI Harmonie (2 km) über Open-Meteo, CC-BY 4.0. Wind in 10 m Höhe. Nur eine Hilfe — der Müller entscheidet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévision du vent : KNMI Harmonie (2 km) via Open-Meteo, CC-BY 4.0. Vent à 10 m de hauteur. Simple aide — le meunier décide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsión del viento: KNMI Harmonie (2 km) vía Open-Meteo, CC-BY 4.0. Viento a 10 m de altura. Solo orientativo — decide el molinero."
          }
        }
      }
    },
